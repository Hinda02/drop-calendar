// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum DropStatus {
  Planned
  InProgress
  Ready
  Launched
  Archived
}

enum DropChannel {
  Website
  TikTok
  Snapchat
  Instagram
  Retail
  Other
}

enum TaskCategory {
  Content
  Samples
  Shipping
  Photoshoot
  Other
}

enum TaskStatus {
  Todo
  Doing
  Done
}

enum TaskPriority {
  Low
  Medium
  High
}

enum ReminderType {
  DaysBefore
  AtTime
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(255)
  name      String?  @db.VarChar(255)
  password  String?  @db.VarChar(255)
  image     String?  @db.VarChar(500)
  settings  Json?    @default("{\"emailReminders\": false, \"reminderEmail\": \"\"}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drops     Drop[]
  reminders Reminder[]

  @@map("users")
  @@index([email])
}

model Drop {
  id          String      @id @default(cuid())
  title       String      @db.VarChar(255)
  description String?     @db.Text
  launchAt    DateTime
  status      DropStatus  @default(Planned)
  channel     DropChannel
  tags        DropTag[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks       Task[]
  reminders   Reminder[]

  @@map("drops")
  @@index([userId])
  @@index([launchAt])
}

model Tag {
  id    String   @id @default(cuid())
  name  String   @unique @db.VarChar(100)
  drops DropTag[]

  @@map("tags")
}

model DropTag {
  dropId String
  tagId  String

  drop Drop @relation(fields: [dropId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([dropId, tagId])
  @@map("drop_tags")
  @@index([dropId])
  @@index([tagId])
}


model Task {
  id        String       @id @default(cuid())
  title     String       @db.VarChar(255)
  category  TaskCategory
  dueAt     DateTime?
  status    TaskStatus   @default(Todo)
  priority  TaskPriority @default(Medium)
  notes     String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  dropId    String
  drop      Drop         @relation(fields: [dropId], references: [id], onDelete: Cascade)

  reminders Reminder[]

  @@map("tasks")
  @@index([dropId])
  @@index([status])
  @@index([dueAt])
}

model Reminder {
  id        String        @id @default(cuid())
  type      ReminderType
  value     Int           // days before or timestamp
  email     String?       @db.VarChar(255)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  dropId    String?
  drop      Drop?         @relation(fields: [dropId], references: [id], onDelete: Cascade)

  taskId    String?
  task      Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("reminders")
  @@index([userId])
  @@index([dropId])
  @@index([taskId])
}
